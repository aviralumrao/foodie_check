# Foodie Check - Environment Variables
# Copy this to .env and set your values

# PostgreSQL Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodie_check

# For local testing without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./foodie_check.db
